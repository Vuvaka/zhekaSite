{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Menu category displayed in storefront category cards and filter tabs.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique category slug identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display title of the category."
        },
        "emoji": {
          "type": "string",
          "maxLength": 16,
          "description": "Category emoji icon."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Short category description."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Category card image URL or asset path."
        },
        "available": {
          "type": "boolean",
          "description": "Whether the category is visible on the storefront."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display sort order for categories."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "id",
        "name",
        "emoji",
        "subtitle",
        "image",
        "available",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Hero banner slide linking to a menu category.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the hero slide."
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target category identifier when clicking the slide CTA."
        },
        "kicker": {
          "type": "string",
          "maxLength": 140,
          "description": "Small yellow kicker text above the slide heading."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Main hero slide headline."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Slide summary paragraph."
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Call-to-action button label."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Hero background image URL or asset path."
        },
        "available": {
          "type": "boolean",
          "description": "Whether the slide is active in the hero slider."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order in the hero slider."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "id",
        "categoryId",
        "kicker",
        "title",
        "description",
        "ctaLabel",
        "image",
        "available",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dish or product item displayed in the restaurant menu catalog.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the menu item."
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Category identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Dish display title."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Dish ingredients or serving description."
        },
        "weight": {
          "type": "string",
          "maxLength": 40,
          "description": "Portion weight or volume."
        },
        "price": {
          "type": "number",
          "description": "Base price in rubles."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Image URL or local asset path."
        },
        "tag": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional badge label."
        },
        "available": {
          "type": "boolean",
          "description": "Whether the item is visible and orderable on the storefront."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display sort order within the catalog."
        },
        "sizes": {
          "type": "array",
          "description": "Optional portion size variants (up to 6)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "id",
        "categoryId",
        "name",
        "description",
        "weight",
        "price",
        "image",
        "available",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized store administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Verified administrator email."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "maxLength": 16,
          "description": "Assigned role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when added."
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Publicly readable menu categories; writable only by authenticated verified admins."
    },
    "/hero_slides/{slideId}": {
      "schema": {
        "$ref": "#/entities/HeroSlide"
      },
      "description": "Publicly readable hero slider banners; writable only by authenticated verified admins."
    },
    "/menu_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/MenuItem"
      },
      "description": "Publicly readable menu catalog items; writable only by authenticated verified admins."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Store administrator registry; readable only by owner or admin, writable only by bootstrapped admin."
    }
  }
}
